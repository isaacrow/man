# ==============================================================================
# MANUSCRIPT 2: ILLUMINATED QUR'AN OPENING FRONTISPIECE
# ==============================================================================

<https://w3id.org/manuscript-ar/item/MS-QURAN-1302> a schema:Manuscript, crm:E22_Human-Made_Object, edm:ProvidedCHO ;
    dc:title "Illuminated Qur'an Opening: Surah Al-Fatihah & Al-Baqarah"@en ;
    dc:title "مصحف شريف مذهب: فاتحة الكتاب وأول البقرة"@ar ;
    dc:title "قرآن خطی نفیس مذهب: سوره فاتحه و بقره"@fa ;
    dc:creator "Master Scribes of the Royal Court Workshop"@en ;
    dc:date "18th-19th Century CE (Qajar / Late Safavid Period)"@en ;
    dc:language "ar" ;
    dc:format "Double-page fully illuminated frontispiece codex"@en ;
    dc:type "Illuminated Sacred Manuscript (Mus'haf)"@en ;
    dc:identifier "MS-QURAN-1302-MAJLIS" ;
    dc:publisher "Parliament Library Collection (Ketabkhaneh-ye Majles)"@en ;
    dc:rights <http://creativecommons.org/publicdomain/mark/1.0/> ;
    
    schema:name "Illuminated Double-Page Qur'an Frontispiece"@en ;
    schema:material "Polished linen rag paper (kaghaz-e dawlatabadi), 24K shell gold (tala-ye hall), lapis lazuli pigment, vermilion rubrication, black carbon ink"@en ;
    schema:artform "Imperial Islamic Illumination (Tadhhib) & Naskh Calligraphy"@en ;
    schema:inLanguage "Classical Arabic"@en ;
    
    ms:dimensions "28.0 cm x 18.5 cm" ;
    ms:folioLayout "Double-column arched illuminated cartouches framed by polylobed arabesque floral borders"@en ;
    ms:rulingTechnique "Mastar (embossed ruling lines in paper)"@en ;
    ms:rubrication "Surah title cartouches and verse separators in shell gold and cinnabar"@en ;
    
    ms:hasHotspot ms:HotspotQuranFatihah, ms:HotspotQuranBaqarah, ms:HotspotQuranBorder, ms:HotspotQuranSeal ;
    
    ms:transcriptionArabic """بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ - الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ - الرَّحْمَنِ الرَّحِيمِ - مَالِكِ يَوْمِ الدِّينِ - إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ - اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ - صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلَا الضَّالِّينَ

بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ - الم - ذَلِكَ الْكِتَابُ لَا رَيْبَ فِيهِ هُدًى لِلْمُتَّقِينَ - الَّذِينَ يُؤْمِنُونَ بِالْغَيْبِ وَيُقِيمُونَ الصَّلَاةَ وَمِمَّا رَزَقْنَاهُمْ يُنْفِقُونَ"""@ar ;
    
    ms:translationEnglish """In the Name of God, the Most Gracious, the Most Merciful. All praise is due to God, Lord of all the worlds. The Most Gracious, the Most Merciful. Master of the Day of Judgment. You alone we worship, and You alone we ask for help. Guide us to the straight path—the path of those upon whom You have bestowed favor, not of those who have evoked Your anger, nor of those who are astray.

In the Name of God, the Most Gracious, the Most Merciful. Alif, Lam, Meem. This is the Book about which there is no doubt, a guidance for those conscious of God—who believe in the unseen, establish prayer, and spend out of what We have provided for them..."""@en .

